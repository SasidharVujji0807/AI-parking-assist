{
  "name": "ai-parking-finder",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Parking Finder",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "start": "node server/dist/server.js",
    "vercel-build": "npm install --prefix client && npm run build --prefix client"
  },
  "dependencies": {
    "@google/genai": "^1.0.1",
    "@supabase/supabase-js": "^2.39.3",
    "@vercel/node": "^3.2.24",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.5",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}
