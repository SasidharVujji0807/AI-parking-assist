# ═══════════════════════════════════════════════════════════════
# AI Parking Finder — Environment Variables
# Copy this file to .env for local development
# Set these as Environment Variables in Vercel dashboard for production
# ═══════════════════════════════════════════════════════════════

# ── Server (used by Express / Vercel Serverless Functions) ────
# Get from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Server config
PORT=5000
NODE_ENV=production

# For local dev, set to your Vite dev server. For production set to your Vercel URL.
CORS_ORIGIN=https://your-app.vercel.app

# ── Client (prefixed with VITE_ — safe to expose in browser) ──
# These are the SAME Supabase values as above but exposed to the frontend
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
